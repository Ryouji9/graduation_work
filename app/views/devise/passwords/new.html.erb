<div class="auth-container">
  <h2>パスワードをお忘れの方</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
    </div>

    <%= f.submit "パスワードリセットメールを送信", class: "btn-primary btn-block" %>
  <% end %>

  <div class="auth-links">
    <%= link_to "ログインはこちら", new_user_session_path %>
    <%= link_to "新規登録はこちら", new_user_registration_path %>
  </div>
</div>
