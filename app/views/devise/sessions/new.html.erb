<div class="auth-container">
  <h2>ログイン</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-group">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
    </div>

    <div class="form-check">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "ログイン状態を保持する" %>
    </div>

    <%= f.submit "ログイン", class: "btn-primary btn-block" %>
  <% end %>

  <div class="auth-links">
    <%= link_to "新規登録はこちら", new_user_registration_path %>
    <%# link_to "パスワードをお忘れの方", new_user_password_path %>
  </div>
</div>
