<div class="selection-form">
  <h1>あなたの悩みを教えてください</h1>

  <%= form_with url: selections_path, method: :post, local: true, data: { turbo: false } do |f| %>

    <div class="step-section">
      <h2>STEP1: あなたの年代を選んでください</h2>
      <div class="choice-group">
        <% ['40代', '50代', '60代', '70代以上'].each do |era| %>
          <label>
            <%= f.radio_button :era, era %>
            <%= era %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="step-section">
      <h2>STEP2: 今の悩みを選んでください（複数選択可）</h2>
      <div class="choice-group">
        <% ['昇進・キャリアアップが止まった', '役職定年・役割の変化', '若手に抜かれた・置いていかれる', '転職すべきか悩んでいる', 'このまま今の会社にいていいのか', '仕事へのモチベーションが下がった', '自分のスキルが時代遅れな気がする', '定年後のキャリアが不安'].each do |worry| %>
          <label>
            <%= f.check_box :worries, { multiple: true }, worry, nil %>
            <%= worry %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="step-section">
      <h2>STEP3: 今の気持ちを選んでください</h2>
      <div class="choice-group">
        <% ['前向きに頑張りたい', 'とにかく現状を変えたい', '誰かに背中を押してほしい', 'ただ話を聞いてほしい'].each do |feeling| %>
          <label>
            <%= f.radio_button :feeling, feeling %>
            <%= feeling %>
          </label>
        <% end %>
      </div>
    </div>

    <%= f.submit "偉人を探す", class: "btn-primary" %>

    <div id="loading" style="display:none; text-align:center; padding:40px;">
      <p>偉人を探しています...<br>少々お待ちください</p>
    </div>

    <script>
      document.querySelector('form').addEventListener('submit', function() {
        document.getElementById('loading').style.display = 'block';
        document.querySelector('.btn-primary').style.display = 'none';
      });
    </script>

  <% end %>
</div>
